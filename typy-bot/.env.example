# Skopiuj ten plik jako .env i uzupełnij.

# Token bota od @BotFather na Telegramie (wymagany do uruchomienia bota)
TELEGRAM_TOKEN=

# Twój numer użytkownika Telegrama (sprawdzisz go u @userinfobot) — daje dostęp do komend admina.
# Kilka osób: oddziel przecinkami.
ADMIN_IDS=

# 1 = wszyscy widzą wszystkie typy (tryb testowy), 0 = pełne typy tylko dla premium
FREE_MODE=1

# Cena subskrypcji premium w gwiazdkach Telegrama (Telegram Stars) i długość w dniach
PREMIUM_PRICE_STARS=250
PREMIUM_DAYS=30

# O której (czas polski) bot wysyła typy dnia subskrybentom
DAILY_HOUR=10
